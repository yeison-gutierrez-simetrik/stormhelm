// cucumber.mjs — status-aware acceptance config (§58/§60, FOLLOW-UP 50)
// Installed by /setup as the consumer's cucumber config (TS+pnpm default).
//
// WHY: the §58 lifecycle lands approved `.feature` files BEFORE their step
// definitions exist (undefined-by-design until each issue's /tdd). The §60 CI
// gate runs the full @release suite — without this filter, every
// approved-but-unimplemented scenario is `undefined` → exit 1, and planning
// PRs + every in-flight slice PR stay red until close-out.
//
// CONTRACT: the CI regression surface is `# status: implemented` features
// ONLY. In-flight slices gate per-issue via /run-acceptance's --tags; the
// close-out flip of `# status:` (INV-8) is the act of JOINING the CI surface.
//
// ⚠️ DO NOT "fix" this with a wrapper that passes a computed file list as CLI
// positional paths: cucumber-js v12 MERGES config `paths` with CLI paths
// (override is deferred to a future major — it prints a deprecation notice
// and runs the UNION). A wrapper is a silent no-op; the narrowing must happen
// HERE, inside the config. (Live: the wrapper shipped first and the full
// suite ran anyway.)
//
// The classic alternative — a `@wip` tag excluded in CI — was considered and
// rejected: it duplicates the `# status:` header into a second channel that
// must rotate per-scenario at close-out (the FOLLOW-UP 49 label↔body fork
// class). One source of truth, already enforced by INV-3/INV-8.
//
// MID-FILE `# status:` FAILS CLOSED (ISSUE #141, FOLLOW-UP 134): status is
// read from the header only — the file's leading comment block — so a
// `# status: implemented` placed per-scenario under an approved header is
// IGNORED: the whole feature is skipped and the run reports green having never
// executed it (belong PRs #350/#357). On the CI surface
// (CUCUMBER_IMPLEMENTED_ONLY=1, i.e. test:acceptance / test:smoke) the config
// THROWS at load naming every file:line; locally it warns on stderr and
// continues. This holds even if the workflow's check-skipped-release-scn.mjs
// step is dropped. One throw blocks every flagged run repo-wide (pre-push smoke
// included) until the file is fixed — fail closed by design.
//
// parseFeatureStatus() below is the ONE reader of `# status:` — the status this
// config honors and the declarations it cannot. It is a verbatim copy of
// scripts/parse-feature-status.mjs (which check-skipped-release-scn.mjs uses),
// duplicated, not imported, because this file is copied to the consumer root
// and must stay self-contained; scripts/__tests__/parse-feature-status.test.mjs
// fails if the copy drifts. Do not export it: a named export here is read by
// cucumber as a profile.

import { readFileSync, readdirSync, statSync } from 'node:fs';
import { join } from 'node:path';

function featureFiles(dir, acc = []) {
  let entries;
  try { entries = readdirSync(dir); } catch { return acc; }
  for (const e of entries) {
    const p = join(dir, e);
    let st;
    try { st = statSync(p); } catch { continue; }   // dangling symlink (an editor lock file) — not a feature
    if (st.isDirectory()) featureFiles(p, acc);
    else if (e.endsWith('.feature')) acc.push(p);
  }
  return acc;
}

// BEGIN parse-feature-status — verbatim copy in templates/cucumber.mjs.tmpl (keep identical)
const STATES = ['draft', 'clarifying', 'approved', 'implemented', 'retired'];
const STATUS_COMMENT = /^\s*#\s*status:\s*(.*)$/i;
const TAG_TRAILING_STATUS = /^\s*@[^#]*#\s*status:\s*(.*)$/i;
const DECLARES_STATE = /^["'`]?(draft|clarifying|approved|implemented|retired)\b/i;
const DOCSTRING_FENCE = /^\s*("""|```)/;

function parseFeatureStatus(text) {
  const lines = text.split(/\r?\n/);
  let headerEnd = 0;
  while (headerEnd < lines.length && /^\s*(#.*)?$/.test(lines[headerEnd])) headerEnd++;
  let status = null;
  let statusLine = 0;
  for (let i = 0; i < headerEnd && !statusLine; i++) {
    const m = STATUS_COMMENT.exec(lines[i]);
    const token = m ? m[1].trim().split(/\s+/)[0] : '';
    if (token) { status = token.toLowerCase(); statusLine = i + 1; }
  }
  const problems = [];
  let fence = null;
  for (let i = headerEnd; i < lines.length; i++) {
    const open = DOCSTRING_FENCE.exec(lines[i]);
    if (open && (fence === null || fence === open[1])) { fence = fence === null ? open[1] : null; continue; }
    if (fence) continue;
    const m = STATUS_COMMENT.exec(lines[i]) || TAG_TRAILING_STATUS.exec(lines[i]);
    if (m && DECLARES_STATE.test(m[1].trim())) problems.push({ line: i + 1, kind: 'mid-file', text: lines[i].trim() });
  }
  return { status, statusLine, headerEnd, problems };
}
// END parse-feature-status

// One read per feature: the status the runner honors + the declarations it cannot.
const features = featureFiles('features').map((f) => ({ f, ...parseFeatureStatus(readFileSync(f, 'utf8')) }));
const unread = features.flatMap(({ f, problems }) => problems.map((p) => `${f}:${p.line} (${p.kind}: ${p.text})`));
if (unread.length) {
  const msg =
    `[cucumber.mjs] ${unread.length} '# status:' declaration(s) this config never reads — status is read from the ` +
    `header block only (the leading comment block), so their feature keeps its header status and its @release ` +
    `scenarios can be skipped while the run reports green (ISSUE #141 / FOLLOW-UP 134):\n` +
    unread.map((s) => `  - ${s}`).join('\n') +
    `\nMove the status to the feature's header block (before its first tag / Feature line), ` +
    `or split the feature so each file carries one header status.`;
  if (process.env.CUCUMBER_IMPLEMENTED_ONLY === '1') throw new Error(msg);
  console.error(`${msg}\n(warning only: CUCUMBER_IMPLEMENTED_ONLY is unset — the CI surface fails closed on this)`);
}

let paths = ['features/**/*.feature'];
if (process.env.CUCUMBER_IMPLEMENTED_ONLY === '1') {
  const implemented = [];
  const skipped = [];
  for (const { f, status: st } of features) {
    // implemented (or legacy header-less) joins the CI surface; anything
    // else (approved, draft, …) is in-flight and gates per-issue instead.
    if (st === null || st === 'implemented') implemented.push(f);
    else skipped.push(`${f} (# status: ${st})`);
  }
  // ZERO implemented features (a fresh consumer's first planning PR — all
  // approved, nothing implemented yet): `paths: []` does NOT mean "run
  // nothing" — cucumber-js v12 falls back to default discovery (features/)
  // and runs the full suite anyway (reproduced live). A benign non-matching
  // glob keeps cucumber semantics: 0 scenarios, exit 0, green planning PR.
  if (implemented.length === 0) {
    console.error('[cucumber.mjs] implemented-only gate: no implemented features yet — regression surface empty (0 scenarios will run)');
    paths = ['features/__none__/*.feature'];
  } else {
    paths = implemented;
  }
  if (skipped.length) {
    // Never silent truncation: say exactly what the gate is not running.
    console.error(
      `[cucumber.mjs] implemented-only gate: skipping ${skipped.length} in-flight feature file(s):\n` +
      skipped.map((s) => `  - ${s}`).join('\n'),
    );
  }
}

export default {
  paths,
  // strict: undefined/pending steps fail the run (§60's third promise) —
  // on the implemented-only surface, every undefined step is a REAL defect.
  strict: true,
};
